# Copy this file to .env and adjust values as needed.
# .env is gitignored; this file documents every variable the stack reads.

# --- General ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Database (used by postgres, backend) ---
POSTGRES_USER=opsboard
POSTGRES_PASSWORD=opsboard
POSTGRES_DB=opsboard

# --- Backend ---
# Comma-separated list of origins allowed to call the API via CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Seed the database with a handful of sample tasks on first startup.
SEED_DATABASE=true

# --- Frontend (baked into the static build at image build time) ---
# Same-origin path is recommended: nginx proxies /api to the backend
# container, so the browser never needs a different host/port.
VITE_API_BASE_URL=/api

# --- Host port mappings (change if these ports are already in use) ---
POSTGRES_EXPOSED_PORT=5432
BACKEND_EXPOSED_PORT=8000
FRONTEND_EXPOSED_PORT=8080
